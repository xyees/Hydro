out_dir <- "data/raw/zenodo_20479866"

target_basin <- NULL

if (!dir.exists(out_dir)) {
  stop("Data folder was not found: ", out_dir,
       ". Run 01_download_data.R first.")
}

find_co2_files <- function(folder) {
  all_rds_files <- list.files(
    folder,
    pattern = "\\.rds$",
    full.names = TRUE,
    recursive = TRUE,
    ignore.case = TRUE
  )
  
  all_rds_files[
    grepl("co2", basename(all_rds_files), ignore.case = TRUE)
  ]
}

co2_files <- find_co2_files(out_dir)

if (length(co2_files) == 0) {
  zip_files <- list.files(
    out_dir,
    pattern = "\\.zip$",
    full.names = TRUE,
    recursive = TRUE,
    ignore.case = TRUE
  )
  
  if (length(zip_files) > 0) {
    for (zip_file in zip_files) {
      message("Extracting: ", basename(zip_file))
      unzip(zip_file, exdir = out_dir)
    }
    
    co2_files <- find_co2_files(out_dir)
  }
}

if (length(co2_files) == 0) {
  rds_files <- list.files(
    out_dir,
    pattern = "\\.rds$",
    full.names = TRUE,
    recursive = TRUE,
    ignore.case = TRUE
  )
  
  stop(
    "No CO2 RDS file was found after extraction.\n",
    "Available RDS files are:\n",
    paste(basename(rds_files), collapse = "\n")
  )
}

message("CO2 files found:")
print(co2_files)

co2_file <- co2_files[1]
co2_data <- readRDS(co2_file)

if (!is.data.frame(co2_data)) {
  co2_data <- as.data.frame(co2_data)
}

message("Using CO2 file: ", co2_file)
message("Rows: ", nrow(co2_data))
message("Columns: ", paste(names(co2_data), collapse = ", "))

# Detect basin ID column
basin_candidates <- names(co2_data)[
  grepl(
    "basin|catchment|gauge|station",
    names(co2_data),
    ignore.case = TRUE
  )
]

if (length(basin_candidates) == 0) {
  stop(
    "No basin column was found.\n",
    "Available columns are: ",
    paste(names(co2_data), collapse = ", ")
  )
}

basin_column <- basin_candidates[1]

message("Using basin column: ", basin_column)

available_basins <- unique(co2_data[[basin_column]])
available_basins <- available_basins[!is.na(available_basins)]

if (length(available_basins) == 0) {
  stop("No basin values were found in column: ", basin_column)
}

message("Number of available basins: ", length(available_basins))
message(
  "First available basins: ",
  paste(head(available_basins, 10), collapse = ", ")
)

if (is.null(target_basin)) {
  target_basin <- available_basins[1]
}

if (!target_basin %in% available_basins) {
  stop(
    "Basin '", target_basin, "' was not found.\n",
    "Choose one of these values: ",
    paste(head(available_basins, 20), collapse = ", ")
  )
}

one_basin_data <- co2_data[
  co2_data[[basin_column]] == target_basin,
  ,
  drop = FALSE
]

if (nrow(one_basin_data) == 0) {
  stop("No rows were found for basin: ", target_basin)
}

message("Selected basin: ", target_basin)
message("Rows in filtered data: ", nrow(one_basin_data))

safe_basin_name <- gsub(
  "[^A-Za-z0-9_-]",
  "_",
  as.character(target_basin)
)

output_file <- file.path(
  out_dir,
  paste0("co2_one_basin_", safe_basin_name, ".rds")
)

saveRDS(one_basin_data, output_file)

message("Filtered basin file saved to: ", output_file)
